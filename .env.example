# ============================================================================
# EDULALIN — Contoh Environment Variables
# Salin file ini menjadi .env lalu isi nilainya sesuai lingkungan Anda.
# JANGAN pernah meng-commit file .env yang berisi kredensial asli.
# ============================================================================

# ----------------------------------------------------------------------------
# AUTH — Kunci enkripsi session JWT (jose HS256, minimal 32 karakter acak).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ----------------------------------------------------------------------------
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# URL aplikasi (opsional).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# DATABASE — Neon PostgreSQL / PostgreSQL apa pun (Prisma 7).
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"

# ----------------------------------------------------------------------------
# SMTP — email notifikasi (pengajuan lupa password ke Admin & perubahan
# password ke pengguna). Kredensial HANYA di environment variable server;
# jangan pernah menaruhnya di kode frontend. Untuk Gmail pakai App Password
# 16 karakter (https://myaccount.google.com/apppasswords).
# Bila SMTP_PASS kosong, pengiriman tercatat FAILED dan Admin dapat mengirim
# ulang dari Dashboard Admin → Notifikasi Email.
# ----------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="alamat.admin@gmail.com"
SMTP_PASS=""
SMTP_FROM="EDULALIN — Edukasi Lalu Lintas <alamat.admin@gmail.com>"
SMTP_REPLY_TO="alamat.admin@gmail.com"

# ----------------------------------------------------------------------------
# STORAGE — Lokasi file unggahan (opsional; default ./storage di lokal,
# /tmp/storage di Vercel).
# ----------------------------------------------------------------------------
# STORAGE_DIR="./storage"
# - Vercel Blob (object storage): bila BLOB_READ_WRITE_TOKEN di-set, seluruh
#   file unggahan (hingga 50 MB) disimpan ke Vercel Blob — tahan redeploy.
# ----------------------------------------------------------------------------
# VERCEL BLOB — Object storage untuk file unggahan besar (hingga 50 MB)
# Dibuat via: vercel blob create-store edulalin-files --access private --yes
# Token otomatis ditambahkan ke .env.local & env Vercel oleh CLI.
# ----------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN