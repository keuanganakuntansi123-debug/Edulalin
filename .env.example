# ============================================================================
# EDULALIN — Contoh Environment Variables
# Salin file ini menjadi .env lalu isi nilainya sesuai lingkungan Anda.
# JANGAN pernah meng-commit file .env yang berisi kredensial asli.
# ============================================================================

# ----------------------------------------------------------------------------
# AUTH — Kunci enkripsi session JWT (jose HS256, minimal 32 karakter acak).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ----------------------------------------------------------------------------
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# URL aplikasi (opsional).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# DATABASE — Neon PostgreSQL / PostgreSQL apa pun (Prisma 7).
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"

# ----------------------------------------------------------------------------
# SMTP Gmail — kirim kode OTP untuk fitur "Lupa Password".
# SMTP_PASS wajib App Password Gmail 16 karakter (bukan password akun):
#   https://myaccount.google.com/apppasswords
# ----------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="email.pengirim@gmail.com"
SMTP_PASS=""
SMTP_FROM="EDULALIN"

# ----------------------------------------------------------------------------
# STORAGE — Lokasi file unggahan (opsional; default ./storage di lokal,
# /tmp/storage di Vercel).
# ----------------------------------------------------------------------------
# STORAGE_DIR="./storage"